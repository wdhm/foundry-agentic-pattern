DOCUMENTATION_MODE=assessment
DOCUMENTATION_AUTH_MODE=azure_cli
DOCUMENTATION_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project>
TOOLBOX_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project>/toolboxes/documentation-agent-readonly/versions/4/mcp?api-version=v1
AZURE_AI_MODEL_DEPLOYMENT_NAME=<existing-chat-deployment>
DOCUMENTATION_MODEL_VERSION=<deployed-model-version>
DOCUMENTATION_ADO_PROJECT=<ado-project>
DOCUMENTATION_ADO_WIKI=<ado-wiki>
# Opt in only with a separately reviewed toolbox version exposing ado___repo_file.
# DOCUMENTATION_ADO_ORGANIZATION=<ado-organization>
# Optional, independently reviewed APIM routes; omit both to retain direct mode.
# Backend identity, model/version and versioned read-toolbox settings above remain required.
# DOCUMENTATION_MODEL_GATEWAY_ENDPOINT=https://<apim-name>.azure-api.net/documentation-model/
# DOCUMENTATION_TOOLBOX_GATEWAY_ENDPOINT=https://<apim-name>.azure-api.net/documentation-tools/mcp?api-version=v1
