{
  "$defs": {
    "AssessmentTask": {
      "additionalProperties": false,
      "properties": {
        "question": {
          "description": "The assessment question, not source evidence, authorization or an expected answer.",
          "maxLength": 8000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Question",
          "type": "string"
        },
        "scope": {
          "enum": [
            "change_review",
            "information_review"
          ],
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "scope",
        "question"
      ],
      "title": "AssessmentTask",
      "type": "object"
    },
    "Subject": {
      "additionalProperties": false,
      "properties": {
        "changed_paths": {
          "items": {
            "minLength": 1,
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Changed Paths",
          "type": "array"
        },
        "commit_sha": {
          "description": "Full Git commit SHA; branches and short SHAs are not accepted.",
          "pattern": "^[0-9a-fA-F]{40}$",
          "title": "Commit Sha",
          "type": "string"
        },
        "pr_reference": {
          "anyOf": [
            {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pr Reference"
        },
        "repo": {
          "description": "Repository URL or owner/repository identifier.",
          "minLength": 1,
          "pattern": "\\S",
          "title": "Repo",
          "type": "string"
        }
      },
      "required": [
        "repo",
        "commit_sha"
      ],
      "title": "Subject",
      "type": "object"
    },
    "VisualizationSource": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "maxLength": 32000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Content",
          "type": "string"
        },
        "source": {
          "enum": [
            "git",
            "wiki",
            "work_item"
          ],
          "title": "Source",
          "type": "string"
        },
        "uri": {
          "pattern": "^https://[^\\s]+$",
          "title": "Uri",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "source",
        "uri",
        "version",
        "content"
      ],
      "title": "VisualizationSource",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "current_section": {
      "anyOf": [
        {
          "maxLength": 16000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Current Section"
    },
    "guidelines_version": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Guidelines Version",
      "type": "string"
    },
    "interface_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Interface Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "sources": {
      "items": {
        "$ref": "#/$defs/VisualizationSource"
      },
      "maxItems": 40,
      "minItems": 1,
      "title": "Sources",
      "type": "array"
    },
    "subject": {
      "$ref": "#/$defs/Subject"
    },
    "target_page": {
      "minLength": 1,
      "pattern": "\\S",
      "title": "Target Page",
      "type": "string"
    },
    "target_section": {
      "const": "Architecture diagram",
      "default": "Architecture diagram",
      "title": "Target Section",
      "type": "string"
    },
    "task": {
      "anyOf": [
        {
          "$ref": "#/$defs/AssessmentTask"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "request_id",
    "correlation_id",
    "subject",
    "task",
    "target_page",
    "current_section",
    "sources",
    "guidelines_version"
  ],
  "title": "VisualizationRequest",
  "type": "object"
}
